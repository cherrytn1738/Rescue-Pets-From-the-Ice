{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Roblox_Studio__*",
      "mcp__blender__*",
      "Edit",
      "Write",
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(rojo build *)",
      "PowerShell(rojo build *)",
      "Bash(python tools/run_specs.py*)",
      "PowerShell(python tools/run_specs.py*)",
      "Bash(blender *)",
      "PowerShell(blender *)",
      "Bash(python tools/*)",
      "PowerShell(python tools/*)",
      "Bash(rojo *)",
      "PowerShell(rojo *)"
    ],
    "ask": [
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)"
    ],
    "additionalDirectories": [
      "C:/Users/USER/Documents/RobloxProjects/StealPetsFromOthers"
    ]
  },
  "enabledMcpjsonServers": ["Roblox_Studio"]
}
