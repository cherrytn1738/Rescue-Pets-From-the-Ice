-- The layers by tier (each tier keeps the layers below it).
local function tierLayers(tier: number, colour: Color3)
	local ambient, hit, lights, beams = {}, {}, {}, {}
	-- 1 Scrappy: no ambient; a puff of dust on every hit
	table.insert(hit, { Name = "Dust", Attachment = "Hit", Texture = "SmokePuff", Color = { rgb(170, 148, 120), rgb(140, 125, 110) }, Burst = 8,
		Size = { 0.9, 2 }, Lifetime = { 0.4, 0.7 }, Speed = { 3, 6 }, Spread = 50, Transparency = { 0.15, 1 }, Drag = 4 })
	if tier >= 2 then -- Workshop: steam puffs, a warm lantern light; hits add a few sparks
		table.insert(ambient, { Name = "Steam", Attachment = "Steam1", Texture = "SmokePuff", Color = { STEAM, rgb(195, 205, 220) }, Rate = 2,
			Size = { 0.7, 2.4 }, Lifetime = { 1.2, 2 }, Speed = { 2, 3 }, Spread = 12, Transparency = { 0.2, 1 }, Acceleration = Vector3.new(0, 1.5, 0) })
		table.insert(lights, { Name = "Lantern", Attachment = "Lamp1", Color = rgb(255, 190, 110), Brightness = 1, Range = 9 })
		table.insert(hit, { Name = "Sparks", Attachment = "Hit", Texture = "Sparkle", Color = { rgb(255, 180, 30), rgb(255, 90, 0) }, Burst = 7,
			Size = { 0.45, 0.1 }, Lifetime = { 0.3, 0.5 }, Speed = { 8, 14 }, Spread = 60, LightEmission = 0.6, Acceleration = Vector3.new(0, -20, 0) })
	end
	if tier >= 3 then -- Frost-tech: cold mist at the base, ice sparkles, a pulsing blue light; hits: ice chips and blue sparks
		table.insert(ambient, { Name = "ColdMist", Attachment = "Aura", Texture = "SmokePuff", Color = { rgb(110, 185, 255), rgb(80, 150, 240) }, Rate = 3,
			Size = { 2, 4 }, Lifetime = { 2, 3 }, Speed = { 0.3, 0.8 }, Spread = 90, Transparency = { 0.45, 1 }, Orbit = true, R = 3 })
		table.insert(ambient, { Name = "IceSparkles", Attachment = "Top", Texture = "Sparkle", Color = { ICE, ICE_DEEP }, Rate = 3,
			Size = { 0.5, 0 }, Lifetime = { 0.8, 1.4 }, Speed = { 0.5, 1.5 }, Spread = 180 })
		table.insert(lights, { Name = "CoilPulse", Attachment = "Work", Color = rgb(110, 200, 255), Brightness = 1.2, Range = 9, Pulse = 1.6 })
		table.insert(hit, { Name = "IceChips", Attachment = "Hit", Texture = "Snowflake", Color = { ICE, ICE_DEEP }, Burst = 8,
			Size = { 0.5, 0.2 }, Lifetime = { 0.4, 0.8 }, Speed = { 6, 10 }, Spread = 55, Acceleration = Vector3.new(0, -25, 0), Spin = 200 })
	end
	if tier >= 4 then -- Enchanted: an aura ring in the building's colour, crystal motes, orbiting runes, light beams from gems
		table.insert(ambient, { Name = "AuraRing", Attachment = "Aura", Texture = "SoftGlow", Color = { colour, colour }, Rate = 8,
			Size = { 1.6, 0.8 }, Lifetime = { 1.5, 2 }, Speed = { 0, 0.2 }, Spread = 0, LightEmission = 0.7, Transparency = { 0.15, 1 }, Orbit = true, R = 4 })
		table.insert(ambient, { Name = "Motes", Attachment = "Aura", Texture = "Sparkle", Color = { colour, colour }, Rate = 4,
			Size = { 0.45, 0.15 }, Lifetime = { 2, 3 }, Speed = { 1, 2 }, Spread = 25, Orbit = true, R = 2.5 })
		table.insert(ambient, { Name = "Runes", Attachment = "Aura", Texture = "Rune1", Color = { rgb(200, 180, 255), rgb(150, 110, 255) }, Rate = 1.5,
			Size = { 0.6, 0.4 }, Lifetime = { 3, 4 }, Speed = { 0.4, 0.8 }, Spread = 10, LightEmission = 1, Orbit = true, R = 3.5, Spin = 30 })
		table.insert(beams, { Name = "GemBeam", From = "Lamp1", To = "Top", Texture = "SoftGlow", Color = colour, Width = 0.4, Speed = 0.5 })
		hit = { hit[1], { Name = "RuneFlash", Attachment = "Hit", Texture = "Rune2", Color = { rgb(220, 200, 255), colour }, Burst = 2,
			Size = { 0.8, 1.6 }, Lifetime = { 0.3, 0.4 }, Speed = { 0, 1 }, Spread = 10, LightEmission = 1, Transparency = { 0, 1 } },
			{ Name = "SparkleBurst", Attachment = "Hit", Texture = "Sparkle", Color = { colour, colour }, Burst = 10,
			Size = { 0.6, 0 }, Lifetime = { 0.4, 0.7 }, Speed = { 5, 9 }, Spread = 180, LightEmission = 0.5 } }
	end
	if tier >= 5 then -- Legendary: a glowing ground ring, a slow light pulse; hits: a big themed burst and a small shockwave
		table.insert(ambient, { Name = "GroundRing", Attachment = "Aura", Texture = "SoftGlow", Color = { colour, GOLD }, Rate = 18,
			Size = { 2.8, 1.6 }, Lifetime = { 2, 2.5 }, Speed = { 0, 0 }, Spread = 0, LightEmission = 1, Transparency = { 0, 1 }, Orbit = true, R = 5 })
		lights = { { Name = "LegendPulse", Attachment = "Top", Color = colour, Brightness = 1.2, Range = 12, Pulse = 2.5 }, lights[1] }
		table.insert(hit, { Name = "Shockwave", Attachment = "Hit", Texture = "SoftGlow", Color = { colour, colour }, Burst = 16,
			Size = { 1.2, 0.4 }, Lifetime = { 0.35, 0.5 }, Speed = { 12, 15 }, Spread = 90, LightEmission = 1, Orbit = true, R = 0.5 })
	end
	return ambient, hit, lights, beams
end

