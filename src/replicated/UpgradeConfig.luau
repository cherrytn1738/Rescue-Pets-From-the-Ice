--[[
UpgradeConfig: every one-time upgrade in the Upgrades panel (docs/GAME_DESIGN.md, "Upgrades in
detail"). Starting values for the economy simulation. All upgrades reset on rebirth.

Four kinds:
 * Tool: the tap power tiers, 18 tools in five families that take turns (Pick, Hammer, Axe, Sword, Spear: the
   spear family includes the Ice Drill). Tier 1 (the Wooden Pick) is what every run starts with; the rest are
   bought in order. Damage and cost come from the economy simulation (tools/economy_sim.py): a new tool about every
   2-3 minutes in the first run, the top tiers only in later runs (layers 5-6). Family says how it's held and
   swung (SwingConfig.Families).
 * FrostTouch: each tier makes every tap also deal a share of the player's building damage per second.
   Unlocked by owning a building.
 * Building upgrades: five per building (BuildingConfig), each doubling that building's damage and
   adding its next upgrade part. The n-th unlocks at UnlockAtOwned[n] copies and costs
   building.BaseCost × CostMultipliers[n].
 * IceUpgrades: Bigger Burst, Crystal Yield, Fast Sled, each with a few tiers.

Upgrades (built below) lists every upgrade with a saved Id (never rename one), Kind, Name and Cost;
ById finds one. The save's Upgrades field holds these ids.
]]
local BuildingConfig = require(script.Parent.BuildingConfig)

local UpgradeConfig = {}

-- The tools, by tier. Saved ids are "Tool" .. Tier (Tool2 to Tool18; Tool1 is the start, never bought).
UpgradeConfig.Tools = {
	{ Tier = 1, Name = "Wooden Pick", Family = "Pick", TapDamage = 1, Cost = 0 }, -- the start
	{ Tier = 2, Name = "Stone Hammer", Family = "Hammer", TapDamage = 2, Cost = 60 },
	{ Tier = 3, Name = "Copper Axe", Family = "Axe", TapDamage = 6, Cost = 2_000 },
	{ Tier = 4, Name = "Iron Pick", Family = "Pick", TapDamage = 20, Cost = 10_000 },
	{ Tier = 5, Name = "Steel Sword", Family = "Sword", TapDamage = 60, Cost = 40_000 },
	{ Tier = 6, Name = "Frost Spear", Family = "Spear", TapDamage = 120, Cost = 100_000 },
	{ Tier = 7, Name = "Gold Hammer", Family = "Hammer", TapDamage = 250, Cost = 250_000 },
	{ Tier = 8, Name = "Crystal Axe", Family = "Axe", TapDamage = 500, Cost = 500_000 },
	{ Tier = 9, Name = "Ice Drill", Family = "Spear", TapDamage = 800, Cost = 750_000 },
	{ Tier = 10, Name = "Diamond Sword", Family = "Sword", TapDamage = 1_200, Cost = 1_500_000 },
	{ Tier = 11, Name = "Flame Pick", Family = "Pick", TapDamage = 2_000, Cost = 3_000_000 },
	{ Tier = 12, Name = "Thunder Hammer", Family = "Hammer", TapDamage = 3_000, Cost = 5_000_000 },
	{ Tier = 13, Name = "Aurora Blade", Family = "Sword", TapDamage = 4_000, Cost = 7_500_000 },
	{ Tier = 14, Name = "Lava Axe", Family = "Axe", TapDamage = 50_000, Cost = 100_000_000, UnlockLevel = 33 },
	{ Tier = 15, Name = "Starfall Spear", Family = "Spear", TapDamage = 250_000, Cost = 2_000_000_000, UnlockLevel = 37 },
	{ Tier = 16, Name = "Comet Hammer", Family = "Hammer", TapDamage = 1_500_000, Cost = 20_000_000_000, UnlockLevel = 41 },
	{ Tier = 17, Name = "Cosmic Pick", Family = "Pick", TapDamage = 6_000_000, Cost = 200_000_000_000, UnlockLevel = 45 },
	{ Tier = 18, Name = "Starbreaker", Family = "Sword", TapDamage = 25_000_000, Cost = 2_000_000_000_000, UnlockLevel = 48 },
}

-- The old ice pick upgrades (before the 18 tools) and the tool each turned into: the same material. A save that
-- still holds IcePick<n> owns every tool up to it (PlayerData's load).
UpgradeConfig.OldPickTiers = { IcePick2 = 2, IcePick3 = 4, IcePick4 = 7, IcePick5 = 10, IcePick6 = 17 }

-- The uploaded tool models (group 921449746; ASSET_IDS.md), by tier; 0 = not made yet (that tier holds the
-- nearest tool of its family: PickService).
-- BEGIN ASSET IDS (generated by tools/write_asset_ids.py from the upload manifests; don't edit by hand)
UpgradeConfig.ToolModelIds = { 0, 0, 0, 121823405442127, 0, 0, 91107081366944, 91759224577271, 101169888558067, 94165974376326, 0, 0, 0, 0, 0, 0, 0, 0 } -- by tier
-- END ASSET IDS
for _, tool in UpgradeConfig.Tools do
	local id = UpgradeConfig.ToolModelIds[tool.Tier]
	tool.ModelId = if id and id > 0 then id else nil
end

UpgradeConfig.FrostTouch = {
	{ Id = "FrostTouch1", Name = "Frost Touch I", TapShareOfBuildingDps = 0.01, Cost = 50_000, UnlockOwns = "WreckingCrane" },
	{ Id = "FrostTouch2", Name = "Frost Touch II", TapShareOfBuildingDps = 0.02, Cost = 5_000_000, UnlockOwns = "FlamethrowerTurret" },
	{ Id = "FrostTouch3", Name = "Frost Touch III", TapShareOfBuildingDps = 0.03, Cost = 500_000_000, UnlockOwns = "SunMirrorTower" },
}

UpgradeConfig.BuildingUpgrades = {
	UnlockAtOwned = { 1, 10, 25, 50, 100 },
	CostMultipliers = { 10, 50, 500, 5_000, 50_000 }, -- × the building's base cost
	DamageMultiplier = 2, -- each one doubles that building's damage
}

UpgradeConfig.IceUpgrades = {
	{ Id = "BiggerBurst", Name = "Bigger Burst", Tiers = 2, Costs = { 5_000, 250_000 },
		BurstSeconds = { 30, 45, 60 } }, -- the rescue fountain is worth this many seconds of income (no tier, tier 1, tier 2)
	{ Id = "CrystalYield", Name = "Crystal Yield", Tiers = 3, Costs = { 20_000, 1_000_000, 50_000_000 },
		YieldPerTier = 0.10 }, -- +10% crystals per point of damage, per tier
	{ Id = "FastSled", Name = "Fast Sled", Tiers = 2, Costs = { 2_000, 100_000 },
		SecondsSoonerPerTier = 1 }, -- the next block arrives 1 second sooner, per tier
}

-- Every upgrade, with its saved id.
UpgradeConfig.Upgrades = {}
UpgradeConfig.ById = {}

local function add(upgrade)
	table.insert(UpgradeConfig.Upgrades, upgrade)
	UpgradeConfig.ById[upgrade.Id] = upgrade
end

for _, tool in UpgradeConfig.Tools do
	if tool.Tier > 1 then
		add({ Id = "Tool" .. tool.Tier, Kind = "Tool", Name = tool.Name, Tier = tool.Tier, Family = tool.Family, Cost = tool.Cost,
			UnlockLevel = tool.UnlockLevel })
	end
end
for _, touch in UpgradeConfig.FrostTouch do
	add({ Id = touch.Id, Kind = "FrostTouch", Name = touch.Name, Cost = touch.Cost, UnlockOwns = touch.UnlockOwns })
end
for _, building in BuildingConfig.Buildings do
	for index, unlockAt in UpgradeConfig.BuildingUpgrades.UnlockAtOwned do
		add({
			Id = building.Id .. "Upgrade" .. index,
			Kind = "Building",
			Name = building.Name .. " upgrade " .. index,
			Building = building.Id,
			Index = index,
			UnlockAtOwned = unlockAt,
			Cost = building.BaseCost * UpgradeConfig.BuildingUpgrades.CostMultipliers[index],
		})
	end
end
for _, ice in UpgradeConfig.IceUpgrades do
	for tier = 1, ice.Tiers do
		add({
			Id = ice.Id .. tier,
			Kind = "Ice",
			Name = ice.Name .. " " .. tier,
			Upgrade = ice.Id,
			Tier = tier,
			Cost = ice.Costs[tier],
		})
	end
end

function UpgradeConfig.Get(id: string)
	return UpgradeConfig.ById[id]
end

return UpgradeConfig
