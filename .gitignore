# .gitignore for a Rojo-managed Roblox project.
# The place file is NOT in Git. It holds everything Rojo doesn't manage: parts, models, terrain,
# imported meshes, lighting. Back it up separately (publish to Roblox, Save to File copies, dated
# backups). Exported models (.rbxm / .rbxmx) are NOT ignored on purpose, so a copy of an important
# hand-built model can be versioned in assets/.

# Roblox place files and Studio's lock files
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Generated by `rojo sourcemap` (rebuild it any time)
sourcemap.json

# Personal tool files
.obsidian/
.claude/settings.local.json
CLAUDE.local.md

# Secrets (Open Cloud API keys, tokens)
.env
.env.*
!.env.example
*.pem

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python caches (tools/)
__pycache__/

# Blender backups (a .blend is versioned; its .blend1 copy is not)
*.blend1

# Playtest screenshots (kept locally)
screenshots/

# Temporary files for long runs (kept out of Git)
tmp/

# Voxel pet build output: keep the sheets, loop GIFs, .blend files, the roster's three views; the rest
# rebuilds with python tools/pets/build_pet.py all
store-assets/creatures/*/render/*
!store-assets/creatures/*/render/view_q34_ol.png
!store-assets/creatures/*/render/variant_*_ol.png

# Building style-test .blend files stay out of Git (large; rebuild with tools/blender/*.py)
store-assets/style-test/**/*.blend

# Building pipeline .blend files stay out of Git (rebuild with tools/blender/buildings/run.py)
store-assets/buildings/**/*.blend
store-assets/tools/**/*.blend
