# .gitignore for a Rojo-managed Roblox project.
# The place file is NOT in Git. It holds everything Rojo doesn't manage: parts, models, terrain,
# imported meshes, lighting. Back it up separately (publish to Roblox, Save to File copies, dated
# backups). Exported models (.rbxm / .rbxmx) are NOT ignored on purpose, so a copy of an important
# hand-built model can be versioned in assets/.

# Roblox place files and Studio's lock files
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Generated by `rojo sourcemap` (rebuild it any time)
sourcemap.json

# Personal tool files
.obsidian/
.claude/settings.local.json
CLAUDE.local.md

# Secrets (Open Cloud API keys, tokens)
.env
.env.*
!.env.example
*.pem

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python caches (tools/)
__pycache__/

# Blender backups (a .blend is versioned; its .blend1 copy is not)
*.blend1

# Playtest screenshots (kept locally)
screenshots/
