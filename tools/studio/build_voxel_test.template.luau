-- REJECTED (2026-11-25): the voxel style test; ServerStorage.VoxelTest was deleted. Kept for reference.
--[[
build_voxel_test.luau (GENERATED by tools/make_voxel_test_builder.py from build_voxel_test.template.luau):
the voxel STYLE TEST templates (Edit mode, then save the place). Builds
ServerStorage.VoxelTest.<A|B>.<Id>.T<tier>: a clone of the real template's Root (the same attachment points)
with the test model's voxel MeshParts (each its colour from the voxel manifest, Plastic, the stud overlay as a
SurfaceAppearance ColorMap in Overlay mode, so the Color shows through; "...Glow" meshes Neon without studs) and Upgrades.U1..U5. The real templates
(ServerStorage.BuildingTemplates) are never changed: tools/studio/voxel_test_swap.luau swaps the test ones in
for a play test only.
]]
local InsertService = game:GetService("InsertService")
local ServerStorage = game:GetService("ServerStorage")

local STUDS = "rbxassetid://--STUDS--"
local MODELS = {
--MODELS--
}

local report = {}
local function folder(parent: Instance, name: string): Instance
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

-- An uploaded model's MeshParts, scaled back to studs about the origin (the buildings import at 25x).
local function load(assetId: number, expectedHeight: number?, knownFactor: number?)
	local container = InsertService:LoadAsset(assetId)
	local parts = {}
	for _, d in container:GetDescendants() do
		if d:IsA("MeshPart") then
			table.insert(parts, d)
		end
	end
	local top = 0
	for _, p in parts do
		top = math.max(top, p.Position.Y + p.Size.Y / 2)
	end
	local factor = knownFactor or 25
	if expectedHeight and not knownFactor then
		local ratio = top / expectedHeight
		factor = if ratio < 5 then 1 elseif ratio < 50 then 25 else 100
	end
	for _, p in parts do
		local rotation = p.CFrame.Rotation
		p.Size = p.Size / factor
		p.CFrame = CFrame.new(p.Position / factor) * rotation
		p.Parent = nil
	end
	container:Destroy()
	return parts, factor
end

local function style(p: MeshPart, info)
	local glow = info and info[2]
	p.Color = Color3.fromHex(info and info[1] or "FFFFFF")
	p.Material = if glow then Enum.Material.Neon else Enum.Material.Plastic
	p.TextureID = ""
	local old = p:FindFirstChildOfClass("SurfaceAppearance")
	if old then
		old:Destroy()
	end
	if not glow then -- the studs: the part's Color shows through the image's clear pixels (Overlay)
		local studs = Instance.new("SurfaceAppearance")
		studs.ColorMap = STUDS
		studs.AlphaMode = Enum.AlphaMode.Overlay
		studs.Parent = p
	end
	p.CastShadow = not glow
	p.Anchored = true
	p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
	p.RenderFidelity = Enum.RenderFidelity.Automatic
	p.DoubleSided = false
end

for _, m in MODELS do
	local real = ServerStorage.BuildingTemplates[m.Id]["T" .. m.Tier]
	local out = folder(folder(folder(ServerStorage, "VoxelTest"), m.Style), m.Id)
	local old = out:FindFirstChild("T" .. m.Tier)
	if old then
		old:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "T" .. m.Tier
	local root = real.Root:Clone()
	root.Parent = model
	model.PrimaryPart = root
	local parts, factor = load(m.Station, m.Height)
	for _, p in parts do
		style(p, m.Parts[p.Name])
		p.Parent = model
	end
	local sets = Instance.new("Folder")
	sets.Name = "Upgrades"
	sets.Parent = model
	local count = 0
	if m.Upgrades then
		local prefix = m.Id .. "T" .. m.Tier .. "U"
		for _, p in (load(m.Upgrades, nil, factor)) do
			local u = string.match(p.Name, "^" .. prefix .. "(%d)")
			if u then
				local set = sets:FindFirstChild("U" .. u)
				if not set then
					set = Instance.new("Model")
					set.Name = "U" .. u
					set.Parent = sets
				end
				style(p, m.Parts[p.Name])
				p.Parent = set
				count += 1
			else
				p:Destroy()
			end
		end
	end
	model.WorldPivot = CFrame.identity
	model:SetAttribute("BuildingId", m.Id)
	model:SetAttribute("Tier", m.Tier)
	model:SetAttribute("VoxelStyle", m.Style)
	model.Parent = out
	local size = model:GetExtentsSize()
	local unstyled = 0
	for _, p in model:GetDescendants() do
		if p:IsA("MeshPart") and not m.Parts[p.Name] then
			unstyled += 1
		end
	end
	table.insert(report, string.format("%s %s T%d: %d meshes (x%d), %d upgrade meshes, height %.1f (manifest %.1f)%s",
		m.Style, m.Id, m.Tier, #parts, factor, count, size.Y, m.Height, if unstyled > 0 then " UNSTYLED " .. unstyled else ""))
	task.wait()
end
return table.concat(report, "\n")
